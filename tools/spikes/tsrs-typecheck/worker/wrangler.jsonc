{
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/schemas/wrangler.schema.json",
	"name": "tsrs-typecheck-spike-local-only",
	"main": "./index.mjs",
	"compatibility_date": "2025-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Local research only. Never deploy this Worker; never target production.
	"workers_dev": false,
	"preview_urls": false,
	"rules": [
		{
			"type": "CompiledWasm",
			"globs": ["**/*.wasm"],
			"fallthrough": true,
		},
	],
}
